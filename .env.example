# =============================================================================
# Ayanfe Food Variety — Environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=8000
SESSION_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=https://www.yourstore.com,https://yourstore.com
PUBLIC_APP_URL=https://www.yourstore.com

# --- Database (Postgres, e.g. Neon) ---
DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# --- Business ---
BUSINESS_TIMEZONE=Africa/Lagos

# =============================================================================
# Redis cache layer (optional, highly recommended for production)
# The store keeps working 100% with the database if Redis is not configured,
# unreachable, or fails — every cache read degrades gracefully to a DB read.
# =============================================================================

# Full Redis connection string. Use TLS for managed providers (Upstash,
# Render Redis, Redis Cloud, AWS ElastiCache in-transit encryption), e.g.
#   REDIS_URL=rediss://:password@host:6379
# Leave empty to run with caching disabled.
REDIS_URL=

# Master switch. Set to "false" to force-disable the cache layer even when a
# REDIS_URL is present (useful for debugging or cacheless deploys).
CACHE_ENABLED=true

# Prefix prepended to every Redis key. Lets multiple environments share one
# Redis instance without clashing. Defaults to "afvc".
CACHE_KEY_PREFIX=afvc

# --- Image hosting (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
BUSINESS_EMAIL=
EMAIL_FROM=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/user/google/callback

# --- Payments ---
PAYMENT_PROVIDER=
PAYMENT_CURRENCY=NGN
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Frontend (Vite) ---
VITE_API_URL=/api/v1