modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 80
exposeLocalhost = true

[[ports]]
localPort = 5002
externalPort = 3001
exposeLocalhost = true

[[ports]]
localPort = 5100
externalPort = 3002
exposeLocalhost = true

[[ports]]
localPort = 5101
externalPort = 3003
exposeLocalhost = true

[[ports]]
localPort = 8000
externalPort = 8000

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "CORS_ORIGINS=\"${CORS_ORIGINS:+$CORS_ORIGINS,}http://127.0.0.1:5000${REPLIT_DEV_DOMAIN:+,https://$REPLIT_DEV_DOMAIN}\" PUBLIC_APP_URL=\"${PUBLIC_APP_URL:-http://127.0.0.1:5000}\" npm run dev"
waitForPort = 5000
