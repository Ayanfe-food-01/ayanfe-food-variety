# Local development uses the Vite proxy. Vercel must use the public Render API URL.
VITE_API_URL=/api/v1
# Optional local backend proxy target.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
# Canonical public storefront origin. Reuse the same value as the API's
# PUBLIC_APP_URL; Vite embeds it into canonical/social metadata at build time.
PUBLIC_APP_URL=https://your-storefront.example.com
# Production example (the client adds /api/v1):
# VITE_API_URL=https://your-api.example.com