{
  "framework": "vite",
  "installCommand": "npm ci --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://ayanfe-food-variety.onrender.com/api/v1/$1"
    },
    {
      "source": "/api/v1",
      "destination": "https://ayanfe-food-variety.onrender.com/api/v1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
