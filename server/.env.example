# Local development and production use the standard Prisma variable.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
PORT=8000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5000
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional Google OAuth. Google sign-in stays disabled until all three values
# are configured and the callback is registered in the Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Used only by `npm run admin:create`; never commit real values. The
# ADMIN_EMAIL and ADMIN_PASSWORD names are preferred for hosted setup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_INITIAL_NAME=
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_FORCE_RESET=false

# Bank transfer details are managed in the database through the admin portal.

# Online payment (Paystack). Online payment stays disabled until PAYMENT_PROVIDER
# is set to PAYSTACK and the Paystack keys below are configured. Use test keys
# (sk_test_...) for development.
# PAYMENT_PROVIDER=PAYSTACK
# PAYMENT_CURRENCY=NGN
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Webhook secret is optional until the Paystack webhook phase.
# PAYSTACK_WEBHOOK_SECRET=xxx

# Store these as server-side secrets, never in source control.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Customer email verification requires RESEND_API_KEY and EMAIL_FROM.
# Existing internal payment notifications also use BUSINESS_EMAIL.
RESEND_API_KEY=your-resend-api-key
BUSINESS_EMAIL=orders@example.com
EMAIL_FROM=Ayanfe Food Variety <orders@example.com>

# ============================================================================
# Redis cache layer (DEVELOPMENT)
# ---------------------------------------------------------
# Optional but recommended. Caching storefront reads in Redis makes pages
# noticeably faster. The store still works 100% with the database alone: if
# Redis is not running, or these lines are left blank, every cache read falls
# gracefully back to a database read.
#
# Copy the example values you need into the repository-root `.env` (that is
# the file the API actually loads), never into this file.
# ============================================================================
# Local Redis (default 6379). Leave empty to run with caching disabled.
REDIS_URL=redis://localhost:6379
# Master switch. Set to "false" to force caching off even with REDIS_URL set
# (useful for debugging cache-related issues).
CACHE_ENABLED=true
# Prefix prepended to every cache key. Lets several environments share one
# Redis instance without key collisions. Keep it short and unique per deploy.
CACHE_KEY_PREFIX=afvc