# Neon pooled or direct PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/database?sslmode=require
NODE_ENV=production
# Render supplies PORT automatically; 10000 is only a local example.
PORT=10000
# Exact Vercel origin(s), comma-separated if more than one is required.
CORS_ORIGINS=https://your-vercel-project.vercel.app
# Used by order email links; it is not part of CORS configuration.
PUBLIC_APP_URL=https://your-vercel-project.vercel.app
SESSION_SECRET=generate-a-random-value-at-least-32-characters-long

# Cloudinary server-side credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Customer email verification requires RESEND_API_KEY and EMAIL_FROM.
# Existing internal payment notifications also use BUSINESS_EMAIL.
RESEND_API_KEY=
BUSINESS_EMAIL=
EMAIL_FROM=

# ============================================================================
# Redis cache layer (PRODUCTION)
# ---------------------------------------------------------
# Use a managed, TLS-enabled Redis (Render Redis, Upstash, Redis Cloud, AWS
# ElastiCache, ...) and paste its `rediss://` connection string. Never commit
# real credentials — set these in the Render dashboard (see render.yaml; the
# REDIS_URL key there is `sync: false` so Render stores the real value).
#
# If Redis has not been provisioned yet, leave REDIS_URL blank: the API then
# serves every storefront read straight from the database. Add Redis later
# without any code change.
# ============================================================================
# Example shape only — replace with the managed provider's TLS URL.
REDIS_URL=rediss://user:password@host:6379
# Master switch. Keep "true" in production; set to "false" only temporarily
# to debug a cache-related issue.
CACHE_ENABLED=true
# Prefix prepended to every cache key. Lets staging and production safely
# share one Redis instance without key collisions.
CACHE_KEY_PREFIX=afvc