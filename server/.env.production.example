# Neon pooled or direct PostgreSQL connection string.
NEON_DATABASE_URL=postgresql://user:password@ep-example.neon.tech/database?sslmode=require
NODE_ENV=production
# Render supplies PORT automatically; 10000 is only a local example.
PORT=10000
# Exact Vercel origin(s), comma-separated if more than one is required.
CORS_ORIGIN=https://your-vercel-project.vercel.app
VERCEL_FRONTEND_URL=https://your-vercel-project.vercel.app
PUBLIC_APP_URL=https://your-vercel-project.vercel.app
SESSION_SECRET=generate-a-random-value-at-least-32-characters-long

# Cloudinary server-side credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional transactional email.
RESEND_API_KEY=
BUSINESS_EMAIL=
EMAIL_FROM=