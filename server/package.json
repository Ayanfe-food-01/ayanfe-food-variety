{
  "name": "ayanfe-food-variety-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "DATABASE_URL=\"${NEON_DATABASE_URL:-$DATABASE_URL}\" prisma migrate deploy",
    "prisma:seed": "DATABASE_URL=\"${NEON_DATABASE_URL:-$DATABASE_URL}\" tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-initial-admin.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test:inventory": "tsx scripts/inventory-safety-smoke.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@types/multer": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "prisma": "^6.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
