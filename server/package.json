{
  "name": "ayanfe-food-variety-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run prisma:generate && tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "npm run prisma:migrate:retry && node dist/server.js",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "node scripts/load-env.mjs validate",
    "prisma:migrate": "node scripts/load-env.mjs migrate deploy",
    "prisma:migrate:status": "node scripts/load-env.mjs migrate status",
    "prisma:migrate:retry": "node scripts/migrate-with-retry.mjs",
    "admin:create": "tsx scripts/create-initial-admin.ts",
    "db:seed": "prisma db seed",
    "doctor": "tsx scripts/doctor.ts",
    "smoke:production": "node scripts/production-smoke.mjs",
    "test:inventory": "tsx scripts/inventory-safety-smoke.ts",
    "test:google-oauth": "tsx scripts/google-oauth-smoke.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/multer": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "google-auth-library": "^11.0.2",
    "multer": "^2.0.2",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed/seed-admin.ts"
  }
}
