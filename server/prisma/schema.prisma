generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  BANK_TRANSFER
}

enum PaymentSubmissionStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  ORDER_PLACED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum UserRole {
  ADMIN
  CUSTOMER
}

model Category {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String    @unique @db.VarChar(120)
  slug           String    @unique @db.VarChar(120)
  description    String    @default("")
  imageUrl       String    @default("") @map("image_url")
  imagePublicId  String?   @map("image_public_id") @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products       Product[]

  @@map("categories")
}

model Product {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String      @map("category_id") @db.Uuid
  name        String      @db.VarChar(180)
  slug        String      @unique @db.VarChar(180)
  description String
  price       Decimal     @db.Decimal(12, 2)
  deliveryFee Decimal     @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  unit        String      @db.VarChar(80)
  image       String
  isActive    Boolean     @default(true) @map("is_active")
  stockQuantity Int        @default(0) @map("stock_quantity")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderItems  OrderItem[]
  cartItems   CustomerCartItem[]
  stockAdjustments ProductStockAdjustment[]

  @@index([categoryId], map: "products_category_id_idx")
  @@index([isActive], map: "products_active_idx")
  @@index([stockQuantity], map: "products_stock_quantity_idx")
  @@map("products")
}

model Order {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber      String      @unique @map("order_number") @db.VarChar(32)
  checkoutKey      String?     @unique @map("checkout_key") @db.Uuid
  userId           String?     @map("user_id") @db.Uuid
  customerName     String      @map("customer_name") @db.VarChar(180)
  phone            String      @db.VarChar(40)
  whatsapp         String?     @db.VarChar(40)
  email            String?     @db.VarChar(255)
  deliveryAddress  String      @map("delivery_address")
  city             String      @db.VarChar(120)
  note             String?
  subtotal         Decimal     @db.Decimal(12, 2)
  deliveryFee      Decimal     @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  total            Decimal     @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  orderStatus      OrderStatus   @default(ORDER_PLACED) @map("order_status")
  stockDeductedAt  DateTime?   @map("stock_deducted_at") @db.Timestamptz(6)
  stockRestoredAt  DateTime?   @map("stock_restored_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  orderItems          OrderItem[]
  paymentSnapshot     OrderPayment?
  paymentSubmissions PaymentSubmission[]
  statusHistory       OrderStatusHistory[]
  stockAdjustments    ProductStockAdjustment[]
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId], map: "orders_user_id_idx")
  @@map("orders")
}

model OrderPayment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String        @unique @map("order_id") @db.Uuid
  paymentMethod  PaymentMethod @map("payment_method")
  bankName       String        @map("bank_name") @db.VarChar(180)
  accountName    String        @map("account_name") @db.VarChar(180)
  accountNumber  String        @map("account_number") @db.VarChar(80)
  instructions   String        @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("order_payments")
}

model PaymentSubmission {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId              String                  @map("order_id") @db.Uuid
  senderName           String                  @map("sender_name") @db.VarChar(180)
  transactionReference String                  @map("transaction_reference") @db.VarChar(180)
  amount               Decimal                 @db.Decimal(12, 2)
  transferredAt        DateTime                @map("transferred_at") @db.Timestamptz(6)
  proofUrl             String                  @map("proof_url")
  status               PaymentSubmissionStatus @default(PENDING)
  reviewNote           String?                 @map("review_note")
  reviewedAt           DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order                Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderId], map: "payment_submissions_order_id_idx")
  @@index([status], map: "payment_submissions_status_idx")
  @@map("payment_submissions")
}

model OrderStatusHistory {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String      @map("order_id") @db.Uuid
  previousStatus OrderStatus? @map("previous_status")
  newStatus      OrderStatus  @map("new_status")
  changedBy      String      @map("changed_by") @db.Uuid
  note           String?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changedByUser  User        @relation(fields: [changedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orderId, createdAt], map: "order_status_history_order_created_idx")
  @@index([changedBy], map: "order_status_history_changed_by_idx")
  @@map("order_status_history")
}

model PaymentSettings {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singletonKey  String        @default("default") @map("singleton_key") @db.VarChar(40)
  paymentMethod PaymentMethod  @default(BANK_TRANSFER) @map("payment_method")
  bankName      String        @map("bank_name") @db.VarChar(180)
  accountName   String        @map("account_name") @db.VarChar(180)
  accountNumber String        @map("account_number") @db.VarChar(80)
  instructions  String        @db.Text
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive], map: "payment_settings_active_idx")
  @@unique([singletonKey, paymentMethod], map: "payment_settings_singleton_method_key")
  @@map("payment_settings")
}

model StoreSettings {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singletonKey    String   @unique @default("default") @map("singleton_key") @db.VarChar(40)
  businessName    String   @map("business_name") @db.VarChar(180)
  businessEmail   String   @map("business_email") @db.VarChar(255)
  businessPhone   String   @map("business_phone") @db.VarChar(40)
  whatsappNumber  String   @map("whatsapp_number") @db.VarChar(40)
  callToOrderPhone String  @map("call_to_order_phone") @db.VarChar(40)
  announcementText String  @map("announcement_text") @db.VarChar(2000)
  address         String   @db.VarChar(500)
  description     String   @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("store_settings")
}

model PromotionalBanner {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String   @db.VarChar(180)
  imageUrl        String   @map("image_url") @db.VarChar(1000)
  imagePublicId   String   @map("image_public_id") @db.VarChar(255)
  promotionalText String?  @map("promotional_text") @db.VarChar(500)
  buttonText      String?  @map("button_text") @db.VarChar(120)
  destination     String?  @db.VarChar(500)
  isActive        Boolean  @default(true) @map("is_active")
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, displayOrder], map: "promotional_banners_active_order_idx")
  @@index([createdAt], map: "promotional_banners_created_at_idx")
  @@map("promotional_banners")
}

model User {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String         @db.VarChar(180)
  email        String         @unique @db.VarChar(255)
  passwordHash String?        @map("password_hash") @db.VarChar(255)
  role         UserRole       @default(ADMIN)
  emailVerified Boolean       @default(true) @map("email_verified")
  phone        String?        @db.VarChar(40)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt  DateTime?      @map("last_login_at") @db.Timestamptz(6)
  sessions     AdminSession[]
  customerSessions CustomerSession[]
  emailVerification CustomerEmailVerification?
  orders       Order[]
  orderStatusChanges OrderStatusHistory[]
  cart         CustomerCart?

  @@map("users")
}

model CustomerEmailVerification {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  otpHash            String   @map("otp_hash") @db.VarChar(128)
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(6)
  attempts           Int      @default(0)
  requestCount       Int      @default(1) @map("request_count")
  requestWindowStart DateTime @map("request_window_start") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "customer_email_verifications_expires_at_idx")
  @@index([requestWindowStart], map: "customer_email_verifications_request_window_idx")
  @@map("customer_email_verifications")
}

model AdminSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "admin_sessions_user_id_idx")
  @@index([expiresAt], map: "admin_sessions_expires_at_idx")
  @@map("admin_sessions")
}

model CustomerSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "customer_sessions_user_id_idx")
  @@index([expiresAt], map: "customer_sessions_expires_at_idx")
  @@map("customer_sessions")
}

model CustomerCart {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String            @unique @map("user_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items     CustomerCartItem[]

  @@map("customer_carts")
}

model CustomerCartItem {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String       @map("cart_id") @db.Uuid
  productId String       @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart      CustomerCart @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([cartId, productId], map: "customer_cart_items_cart_product_key")
  @@index([productId], map: "customer_cart_items_product_id_idx")
  @@map("customer_cart_items")
}

model OrderItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(180)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(12, 2)
  deliveryFee Decimal  @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orderId], map: "order_items_order_id_idx")
  @@index([productId], map: "order_items_product_id_idx")
  @@map("order_items")
}

model ProductStockAdjustment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  orderId        String?  @map("order_id") @db.Uuid
  quantityDelta  Int      @map("quantity_delta")
  previousQuantity Int    @map("previous_quantity")
  newQuantity    Int      @map("new_quantity")
  reason         String   @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([productId, createdAt], map: "product_stock_adjustments_product_created_idx")
  @@index([orderId], map: "product_stock_adjustments_order_id_idx")
  @@map("product_stock_adjustments")
}