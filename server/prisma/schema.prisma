generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum ProductDiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  BANK_TRANSFER
}

enum PaymentSubmissionStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentRejectionReason {
  AMOUNT_MISMATCH
  PROOF_UNCLEAR
  TRANSACTION_UNVERIFIED
  WRONG_ACCOUNT
  DUPLICATE_PROOF
  OTHER
}

enum PaymentAuditAction {
  PROOF_SUBMITTED
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
}

enum OrderStatus {
  ORDER_PLACED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum ShoppingMode {
  RETAIL
  WHOLESALE
}

enum AdminNotificationType {
  NEW_ORDER
  PAYMENT_PROOF_SUBMITTED
  PAYMENT_CONFIRMED
  CUSTOMER_ORDER_CANCELLED
  LOW_STOCK
}

model Category {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String    @unique @db.VarChar(120)
  slug           String    @unique @db.VarChar(120)
  description    String    @default("")
  imageUrl       String    @default("") @map("image_url")
  imagePublicId  String?   @map("image_public_id") @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products       Product[]

  @@map("categories")
}

model Product {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String      @map("category_id") @db.Uuid
  name        String      @db.VarChar(180)
  slug        String      @unique @db.VarChar(180)
  description String
  price        Decimal            @db.Decimal(12, 2)
  discountType ProductDiscountType? @map("discount_type")
  discountValue Decimal?          @map("discount_value") @db.Decimal(12, 2)
  deliveryFee  Decimal            @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  unit        String      @db.VarChar(80)
  image       String
  isActive    Boolean     @default(true) @map("is_active")
  isFeatured  Boolean     @default(false) @map("is_featured")
  stockQuantity Int        @default(0) @map("stock_quantity")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderItems  OrderItem[]
  cartItems   CustomerCartItem[]
  stockAdjustments ProductStockAdjustment[]
  wishlistItems WishlistItem[]
  images      ProductImage[]
  options     ProductOption[]
  wholesalePriceTiers WholesalePriceTier[]

  @@index([categoryId], map: "products_category_id_idx")
  @@index([isActive], map: "products_active_idx")
  @@index([isFeatured, isActive], map: "products_featured_active_idx")
  @@index([stockQuantity], map: "products_stock_quantity_idx")
  @@map("products")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar(1000)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([productId, sortOrder], map: "product_images_product_order_key")
  @@index([productId], map: "product_images_product_id_idx")
  @@map("product_images")
}

model WholesalePriceTier {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String          @map("product_id") @db.Uuid
  productOptionId String?         @map("product_option_id") @db.Uuid
  minQuantity     Int             @default(1) @map("min_quantity")
  maxQuantity     Int?            @map("max_quantity")
  price           Decimal         @db.Decimal(12, 2)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productOption   ProductOption?  @relation(fields: [productOptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([productId, productOptionId, minQuantity], map: "wholesale_price_tiers_product_option_min_qty_key")
  @@index([productId, minQuantity], map: "wholesale_price_tiers_product_min_qty_idx")
  @@map("wholesale_price_tiers")
}

model ProductOption {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  label         String   @db.VarChar(80)
  price         Decimal  @db.Decimal(12, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  wholesaleMoq  Int?     @map("wholesale_moq")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cartItems     CustomerCartItem[]
  orderItems    OrderItem[]
  stockAdjustments ProductStockAdjustment[]
  wholesalePriceTiers WholesalePriceTier[]

  @@unique([productId, label], map: "product_options_product_label_key")
  @@index([productId, sortOrder], map: "product_options_product_order_idx")
  @@map("product_options")
}

model Order {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber      String      @unique @map("order_number") @db.VarChar(32)
  checkoutKey      String?     @unique @map("checkout_key") @db.Uuid
  guestAccessTokenHash String? @unique @map("guest_access_token_hash") @db.VarChar(64)
  userId           String?     @map("user_id") @db.Uuid
  customerName     String      @map("customer_name") @db.VarChar(180)
  phone            String      @db.VarChar(40)
  whatsapp         String?     @db.VarChar(40)
  email            String?     @db.VarChar(255)
  deliveryAddress  String      @map("delivery_address")
  city             String      @db.VarChar(120)
  note             String?
  subtotal         Decimal     @db.Decimal(12, 2)
  deliveryFee      Decimal     @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  total            Decimal     @db.Decimal(12, 2)
  fulfillmentMethod FulfillmentMethod @default(DELIVERY) @map("fulfillment_method")
  shoppingMode    ShoppingMode    @default(RETAIL) @map("shopping_mode")
  paymentMethod    PaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  orderStatus      OrderStatus   @default(ORDER_PLACED) @map("order_status")
  cancellationReason String?     @map("cancellation_reason") @db.VarChar(500)
  cancelledAt      DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  stockDeductedAt  DateTime?   @map("stock_deducted_at") @db.Timestamptz(6)
  stockRestoredAt  DateTime?   @map("stock_restored_at") @db.Timestamptz(6)
  archivedAt       DateTime?     @map("archived_at") @db.Timestamptz(6)
  archivedById     String?       @map("archived_by_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  orderItems          OrderItem[]
  paymentSnapshot     OrderPayment?
  paymentSubmissions PaymentSubmission[]
  statusHistory       OrderStatusHistory[]
  stockAdjustments    ProductStockAdjustment[]
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  archivedBy          User?       @relation("OrderArchiveActor", fields: [archivedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId], map: "orders_user_id_idx")
  @@index([archivedAt], map: "orders_archived_at_idx")
  @@index([archivedAt, createdAt(sort: Desc)], map: "orders_archived_created_idx")
  @@index([paymentStatus, orderStatus], map: "orders_payment_order_status_idx")
  @@map("orders")
}

model OrderPayment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String        @unique @map("order_id") @db.Uuid
  paymentMethod  PaymentMethod @map("payment_method")
  bankName       String        @map("bank_name") @db.VarChar(180)
  accountName    String        @map("account_name") @db.VarChar(180)
  accountNumber  String        @map("account_number") @db.VarChar(80)
  instructions   String        @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("order_payments")
}

model PaymentSubmission {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId              String                  @map("order_id") @db.Uuid
  senderName           String                  @map("sender_name") @db.VarChar(180)
  transactionReference String?                 @map("transaction_reference") @db.VarChar(180)
  amount               Decimal                 @db.Decimal(12, 2)
  transferredAt        DateTime                @map("transferred_at") @db.Timestamptz(6)
  proofUrl             String                  @map("proof_url")
  status               PaymentSubmissionStatus @default(PENDING)
  rejectionReason      PaymentRejectionReason? @map("rejection_reason")
  reviewNote           String?                 @map("review_note")
  reviewedAt           DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order                Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  auditEvents          PaymentAuditEvent[]

  @@index([orderId], map: "payment_submissions_order_id_idx")
  @@index([status], map: "payment_submissions_status_idx")
  @@index([status, createdAt(sort: Desc)], map: "payment_submissions_status_created_idx")
  @@map("payment_submissions")
}

model PaymentAuditEvent {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentSubmissionId String            @map("payment_submission_id") @db.Uuid
  action              PaymentAuditAction
  performedById       String?           @map("performed_by_id") @db.Uuid
  note                String?           @db.VarChar(1000)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  paymentSubmission   PaymentSubmission @relation(fields: [paymentSubmissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  performedBy         User?             @relation("PaymentAuditActor", fields: [performedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([paymentSubmissionId, createdAt], map: "payment_audit_events_submission_created_idx")
  @@index([performedById], map: "payment_audit_events_performed_by_idx")
  @@map("payment_audit_events")
}

model OrderStatusHistory {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String      @map("order_id") @db.Uuid
  previousStatus OrderStatus? @map("previous_status")
  newStatus      OrderStatus  @map("new_status")
  changedBy      String?     @map("changed_by") @db.Uuid
  note           String?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changedByUser  User?       @relation(fields: [changedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orderId, createdAt], map: "order_status_history_order_created_idx")
  @@index([changedBy], map: "order_status_history_changed_by_idx")
  @@map("order_status_history")
}

model PaymentSettings {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singletonKey  String        @default("default") @map("singleton_key") @db.VarChar(40)
  paymentMethod PaymentMethod  @default(BANK_TRANSFER) @map("payment_method")
  bankName      String        @map("bank_name") @db.VarChar(180)
  accountName   String        @map("account_name") @db.VarChar(180)
  accountNumber String        @map("account_number") @db.VarChar(80)
  instructions  String        @db.Text
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive], map: "payment_settings_active_idx")
  @@unique([singletonKey, paymentMethod], map: "payment_settings_singleton_method_key")
  @@map("payment_settings")
}

model StoreSettings {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singletonKey    String   @unique @default("default") @map("singleton_key") @db.VarChar(40)
  businessName    String   @map("business_name") @db.VarChar(180)
  businessEmail   String   @map("business_email") @db.VarChar(255)
  businessPhone   String   @map("business_phone") @db.VarChar(40)
  whatsappNumber  String   @map("whatsapp_number") @db.VarChar(40)
  callToOrderPhone String  @map("call_to_order_phone") @db.VarChar(40)
  announcementText String  @map("announcement_text") @db.VarChar(2000)
  address         String   @db.VarChar(500)
  description     String   @db.VarChar(500)
  openingHours    String   @default("") @map("opening_hours") @db.VarChar(500)
  pickupInformation String @default("") @map("pickup_information") @db.VarChar(1000)
  deliveryInformation String @default("") @map("delivery_information") @db.VarChar(1000)
  mapEmbedUrl     String   @default("") @map("map_embed_url") @db.VarChar(2000)
  logoUrl         String?  @map("logo_url") @db.VarChar(1000)
  logoPublicId    String?  @map("logo_public_id") @db.VarChar(255)
  faviconUrl      String?  @map("favicon_url") @db.VarChar(1000)
  faviconPublicId String?  @map("favicon_public_id") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("store_settings")
}

model PromotionalBanner {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String   @db.VarChar(180)
  imageUrl        String   @map("image_url") @db.VarChar(1000)
  imagePublicId   String   @map("image_public_id") @db.VarChar(255)
  promotionalText String?  @map("promotional_text") @db.VarChar(500)
  buttonText      String?  @map("button_text") @db.VarChar(120)
  destination     String?  @db.VarChar(500)
  isActive        Boolean  @default(true) @map("is_active")
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, displayOrder], map: "promotional_banners_active_order_idx")
  @@index([createdAt], map: "promotional_banners_created_at_idx")
  @@map("promotional_banners")
}

model User {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String         @db.VarChar(180)
  email        String         @unique @db.VarChar(255)
  passwordHash String?        @map("password_hash") @db.VarChar(255)
  role         UserRole       @default(ADMIN)
  authProvider AuthProvider   @default(PASSWORD) @map("auth_provider")
  googleSubject String?       @unique @map("google_subject") @db.VarChar(255)
  emailVerified Boolean       @default(true) @map("email_verified")
  shoppingMode ShoppingMode   @default(RETAIL) @map("shopping_mode")
  phone        String?        @db.VarChar(40)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt  DateTime?      @map("last_login_at") @db.Timestamptz(6)
  sessions     AdminSession[]
  customerSessions CustomerSession[]
  emailVerification CustomerEmailVerification?
  passwordResetTokens PasswordResetToken[]
  orders       Order[]
  archivedOrders Order[] @relation("OrderArchiveActor")
  orderStatusChanges OrderStatusHistory[]
  carts        CustomerCart[]
  paymentAuditEvents PaymentAuditEvent[] @relation("PaymentAuditActor")
  notificationReads AdminNotificationRead[]
  wishlistItems WishlistItem[]

  @@map("users")
}

model AdminNotification {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      AdminNotificationType
  eventKey  String                 @unique @map("event_key") @db.VarChar(255)
  title     String                 @db.VarChar(180)
  message   String                 @db.VarChar(500)
  href      String                 @db.VarChar(500)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  reads     AdminNotificationRead[]

  @@index([createdAt], map: "admin_notifications_created_at_idx")
  @@index([type, createdAt], map: "admin_notifications_type_created_at_idx")
  @@map("admin_notifications")
}

model AdminNotificationRead {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String            @map("notification_id") @db.Uuid
  adminId        String            @map("admin_id") @db.Uuid
  readAt         DateTime          @default(now()) @map("read_at") @db.Timestamptz(6)
  notification   AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admin          User              @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([notificationId, adminId], map: "admin_notification_reads_notification_admin_key")
  @@index([adminId, readAt], map: "admin_notification_reads_admin_read_at_idx")
  @@map("admin_notification_reads")
}

model CustomerEmailVerification {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  otpHash            String   @map("otp_hash") @db.VarChar(128)
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(6)
  attempts           Int      @default(0)
  requestCount       Int      @default(1) @map("request_count")
  requestWindowStart DateTime @map("request_window_start") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "customer_email_verifications_expires_at_idx")
  @@index([requestWindowStart], map: "customer_email_verifications_request_window_idx")
  @@map("customer_email_verifications")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "password_reset_tokens_user_id_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

model AdminSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "admin_sessions_user_id_idx")
  @@index([expiresAt], map: "admin_sessions_expires_at_idx")
  @@map("admin_sessions")
}

model CustomerSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "customer_sessions_user_id_idx")
  @@index([expiresAt], map: "customer_sessions_expires_at_idx")
  @@map("customer_sessions")
}

model CustomerCart {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  mode      ShoppingMode      @default(RETAIL) @map("mode")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items     CustomerCartItem[]

  @@unique([userId, mode], map: "customer_carts_user_mode_key")
  @@index([userId, mode], map: "customer_carts_user_mode_idx")
  @@map("customer_carts")
}

model CustomerCartItem {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId          String        @map("cart_id") @db.Uuid
  productId       String        @map("product_id") @db.Uuid
  productOptionId String?       @map("product_option_id") @db.Uuid
  quantity        Int
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart            CustomerCart  @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  productOption   ProductOption? @relation(fields: [productOptionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([cartId, productId, productOptionId], map: "customer_cart_items_cart_product_option_key")
  @@index([productId], map: "customer_cart_items_product_id_idx")
  @@index([cartId, productId], map: "customer_cart_items_cart_product_idx")
  @@index([productOptionId], map: "customer_cart_items_product_option_id_idx")
  @@map("customer_cart_items")
}

model WishlistItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, productId], map: "wishlist_items_user_product_key")
  @@index([userId, createdAt], map: "wishlist_items_user_created_idx")
  @@index([productId], map: "wishlist_items_product_id_idx")
  @@map("wishlist_items")
}

model OrderItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productOptionId String? @map("product_option_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(180)
  productOptionLabel String? @map("product_option_label") @db.VarChar(80)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(12, 2)
  deliveryFee Decimal  @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  productOption ProductOption? @relation(fields: [productOptionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orderId], map: "order_items_order_id_idx")
  @@index([productId], map: "order_items_product_id_idx")
  @@index([productOptionId], map: "order_items_product_option_id_idx")
  @@map("order_items")
}

model ProductStockAdjustment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  productOptionId String? @map("product_option_id") @db.Uuid
  orderId        String?  @map("order_id") @db.Uuid
  quantityDelta  Int      @map("quantity_delta")
  previousQuantity Int    @map("previous_quantity")
  newQuantity    Int      @map("new_quantity")
  reason         String   @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  productOption  ProductOption? @relation(fields: [productOptionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([productId, createdAt], map: "product_stock_adjustments_product_created_idx")
  @@index([orderId], map: "product_stock_adjustments_order_id_idx")
  @@index([productOptionId], map: "product_stock_adjustments_product_option_id_idx")
  @@map("product_stock_adjustments")
}