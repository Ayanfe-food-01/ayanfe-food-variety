generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// Payment gateway provider. Only the provider selected by the active gateway
// settings is available at checkout. Add values here as more providers are
// integrated.
enum PaymentProvider {
  PAYSTACK
}

// Lifecycle status of an individual gateway payment record. Kept separate from
// the aggregate Order.paymentStatus (PENDING/PAID/FAILED) so the existing
// bank-transfer flow is not disturbed.
enum PaymentRecordStatus {
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
}

enum ProductDiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  BANK_TRANSFER
  PAYSTACK
}

enum PaymentSubmissionStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentRejectionReason {
  AMOUNT_MISMATCH
  PROOF_UNCLEAR
  TRANSACTION_UNVERIFIED
  WRONG_ACCOUNT
  DUPLICATE_PROOF
  OTHER
}

enum PaymentAuditAction {
  PROOF_SUBMITTED
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
}

enum OrderStatus {
  ORDER_PLACED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum ShoppingMode {
  RETAIL
  WHOLESALE
}

enum AdminNotificationType {
  NEW_ORDER
  PAYMENT_PROOF_SUBMITTED
  PAYMENT_CONFIRMED
  CUSTOMER_ORDER_CANCELLED
  LOW_STOCK
  NEW_QUOTE_REQUEST
  QUOTE_ACCEPTED
  QUOTE_REJECTED
}

enum QuoteRequestStatus {
  PENDING
  CONTACTED
  QUOTED
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Category {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String    @unique @db.VarChar(120)
  slug           String    @unique @db.VarChar(120)
  description    String    @default("")
  imageUrl       String    @default("") @map("image_url")
  imagePublicId  String?   @map("image_public_id") @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products       Product[]

  @@map("categories")
}

model Product {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String      @map("category_id") @db.Uuid
  name        String      @db.VarChar(180)
  slug        String      @unique @db.VarChar(180)
  description String
  price        Decimal            @db.Decimal(12, 2)
  discountType ProductDiscountType? @map("discount_type")
  discountValue Decimal?          @map("discount_value") @db.Decimal(12, 2)
  deliveryFee  Decimal            @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  unit        String      @db.VarChar(80)
  image       String
  isActive    Boolean     @default(true) @map("is_active")
  isFeatured  Boolean     @default(false) @map("is_featured")
  stockQuantity Int        @default(0) @map("stock_quantity")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderItems  OrderItem[]
  cartItems   CustomerCartItem[]
  stockAdjustments ProductStockAdjustment[]
  wishlistItems WishlistItem[]
  images      ProductImage[]
  options     ProductOption[]
  wholesalePriceTiers WholesalePriceTier[]
  quoteRequestItems QuoteRequestItem[]
  reviews          Review[]

  @@index([categoryId], map: "products_category_id_idx")
  @@index([isActive], map: "products_active_idx")
  @@index([isFeatured, isActive], map: "products_featured_active_idx")
  @@index([stockQuantity], map: "products_stock_quantity_idx")
  @@map("products")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar(1000)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([productId, sortOrder], map: "product_images_product_order_key")
  @@index([productId], map: "product_images_product_id_idx")
  @@map("product_images")
}

model WholesalePriceTier {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String          @map("product_id") @db.Uuid
  productOptionId String?         @map("product_option_id") @db.Uuid
  minQuantity     Int             @default(1) @map("min_quantity")
  maxQuantity     Int?            @map("max_quantity")
  price           Decimal         @db.Decimal(12, 2)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productOption   ProductOption?  @relation(fields: [productOptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([productId, productOptionId, minQuantity], map: "wholesale_price_tiers_product_option_min_qty_key")
  @@index([productId, minQuantity], map: "wholesale_price_tiers_product_min_qty_idx")
  @@map("wholesale_price_tiers")
}

model ProductOption {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  label         String   @db.VarChar(80)
  price         Decimal  @db.Decimal(12, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  wholesaleMoq  Int?     @map("wholesale_moq")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cartItems     CustomerCartItem[]
  orderItems    OrderItem[]
  stockAdjustments ProductStockAdjustment[]
  wholesalePriceTiers WholesalePriceTier[]
  quoteRequestItems QuoteRequestItem[]

  @@unique([productId, label], map: "product_options_product_label_key")
  @@index([productId, sortOrder], map: "product_options_product_order_idx")
  @@map("product_options")
}

model DeliveryZone {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fee                  Decimal  @db.Decimal(12, 2)
  freeDeliveryThreshold Decimal? @map("free_delivery_threshold") @db.Decimal(12, 2)
  minDeliveryDays      Int?     @map("min_delivery_days")
  maxDeliveryDays      Int?     @map("max_delivery_days")
  isActive             Boolean  @default(true) @map("is_active")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  orders               Order[]
  deliveryZoneCities   DeliveryZoneCity[]

  @@index([isActive, sortOrder], map: "delivery_zones_active_order_idx")
  @@index([sortOrder], map: "delivery_zones_sort_order_idx")
  @@map("delivery_zones")
}

// Nigerian states and the FCT. Seeded by the delivery-location seed and used by
// the State -> City checkout flow (delivery redesign Phase 1).
model State {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(120)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cities City[]

  @@index([sortOrder], map: "states_sort_order_idx")
  @@map("states")
}

// A city/town belongs to exactly one state. Seeded with a curated subset of
// well-known cities; admins may add more. Unique per state.
model City {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stateId   String   @map("state_id") @db.Uuid
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  state            State              @relation(fields: [stateId], references: [id], onDelete: Restrict)
  deliveryZoneCity DeliveryZoneCity?

  @@unique([stateId, name], map: "cities_state_name_key")
  @@index([stateId], map: "cities_state_id_idx")
  @@map("cities")
}

// Maps a city to the delivery zone that covers it. A zone may serve many
// cities; a city belongs to at most one zone. Cities not yet mapped simply have
// no zone, so checkout can resolve them once an admin assigns one.
model DeliveryZoneCity {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryZoneId String   @map("delivery_zone_id") @db.Uuid
  cityId         String   @unique @map("city_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  deliveryZone DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
  city         City         @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([deliveryZoneId], map: "delivery_zone_cities_zone_id_idx")
  @@map("delivery_zone_cities")
}

model Order {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber      String      @unique @map("order_number") @db.VarChar(32)
  checkoutKey      String?     @unique @map("checkout_key") @db.Uuid
  guestAccessTokenHash String? @unique @map("guest_access_token_hash") @db.VarChar(64)
  userId           String?     @map("user_id") @db.Uuid
  customerName     String      @map("customer_name") @db.VarChar(180)
  phone            String      @db.VarChar(40)
  whatsapp         String?     @db.VarChar(40)
  email            String?     @db.VarChar(255)
  deliveryAddress  String      @map("delivery_address")
  city             String      @db.VarChar(120)
  note             String?
  subtotal         Decimal     @db.Decimal(12, 2)
  deliveryFee      Decimal     @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  // Delivery zone snapshot captured at order time. The name and fee are stored
  // directly on the order so historical orders are never affected by later
  // edits to a zone's fee or name. deliveryZoneId is informational only.
  deliveryZoneId   String?     @map("delivery_zone_id") @db.Uuid
  deliveryZoneName String?     @map("delivery_zone_name") @db.VarChar(120)
  // Estimated delivery time snapshot (business days) captured at order time,
  // following the same pattern as deliveryZoneName/Fee. Nullable so orders
  // placed before delivery-time was configured remain valid.
  deliveryMinDays  Int?        @map("delivery_min_days")
  deliveryMaxDays  Int?        @map("delivery_max_days")
  total            Decimal     @db.Decimal(12, 2)
  fulfillmentMethod FulfillmentMethod @default(DELIVERY) @map("fulfillment_method")
  shoppingMode    ShoppingMode    @default(RETAIL) @map("shopping_mode")
  paymentMethod    PaymentMethod @default(BANK_TRANSFER) @map("payment_method")
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  paymentConfirmedAt DateTime?    @map("payment_confirmed_at") @db.Timestamptz(6)
  // Source cart rows kept for a gateway order until its payment is confirmed,
  // so an abandoned/failed payment does not silently empty the customer's cart.
  paymentCartItemIds Json?        @map("payment_cart_item_ids")
  orderStatus      OrderStatus   @default(ORDER_PLACED) @map("order_status")
  cancellationReason String?     @map("cancellation_reason") @db.VarChar(500)
  cancelledAt      DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  stockDeductedAt  DateTime?   @map("stock_deducted_at") @db.Timestamptz(6)
  stockRestoredAt  DateTime?   @map("stock_restored_at") @db.Timestamptz(6)
  archivedAt       DateTime?     @map("archived_at") @db.Timestamptz(6)
  archivedById     String?       @map("archived_by_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  quoteRequestId      String?     @unique @map("quote_request_id") @db.Uuid
  orderItems          OrderItem[]
  paymentSnapshot     OrderPayment?
  paymentSubmissions PaymentSubmission[]
  payments           Payment[]
  statusHistory       OrderStatusHistory[]
  stockAdjustments    ProductStockAdjustment[]
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  archivedBy          User?       @relation("OrderArchiveActor", fields: [archivedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  quoteRequest        QuoteRequest? @relation("QuoteSourceOrder", fields: [quoteRequestId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  convertedQuoteRequests QuoteRequest[] @relation("QuoteConvertedOrder")
  deliveryZone        DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reviews              Review[]

  @@index([userId], map: "orders_user_id_idx")
  @@index([archivedAt], map: "orders_archived_at_idx")
  @@index([archivedAt, createdAt(sort: Desc)], map: "orders_archived_created_idx")
  @@index([paymentStatus, orderStatus], map: "orders_payment_order_status_idx")
  @@index([deliveryZoneId], map: "orders_delivery_zone_id_idx")
  @@map("orders")
}

model OrderPayment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String        @unique @map("order_id") @db.Uuid
  paymentMethod  PaymentMethod @map("payment_method")
  bankName       String        @map("bank_name") @db.VarChar(180)
  accountName    String        @map("account_name") @db.VarChar(180)
  accountNumber  String        @map("account_number") @db.VarChar(80)
  instructions   String        @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("order_payments")
}

// A provider-agnostic payment transaction record tied to an order. This is the
// foundation for gateway (Paystack) payments. Bank-transfer payments continue to
// use OrderPayment + PaymentSubmission; this model does not replace them.
model Payment {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String             @map("order_id") @db.Uuid
  provider         PaymentProvider    @map("provider")
  providerReference String            @map("provider_reference") @db.VarChar(255)
  amount           Decimal            @db.Decimal(12, 2)
  currency         String             @default("NGN") @db.VarChar(8)
  status           PaymentRecordStatus @default(PENDING)
  method           String?            @db.VarChar(60)
  providerMetadata Json?              @map("provider_metadata")
  initializedAt    DateTime           @default(now()) @map("initialized_at") @db.Timestamptz(6)
  completedAt      DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerReference], map: "payment_provider_reference_key")
  @@index([orderId], map: "payments_order_id_idx")
  @@index([status], map: "payments_status_idx")
  @@index([provider, status], map: "payments_provider_status_idx")
  @@map("payments")
}

model PaymentSubmission {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId              String                  @map("order_id") @db.Uuid
  senderName           String                  @map("sender_name") @db.VarChar(180)
  transactionReference String?                 @map("transaction_reference") @db.VarChar(180)
  amount               Decimal                 @db.Decimal(12, 2)
  transferredAt        DateTime                @map("transferred_at") @db.Timestamptz(6)
  proofUrl             String                  @map("proof_url")
  status               PaymentSubmissionStatus @default(PENDING)
  rejectionReason      PaymentRejectionReason? @map("rejection_reason")
  reviewNote           String?                 @map("review_note")
  reviewedAt           DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order                Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  auditEvents          PaymentAuditEvent[]

  @@index([orderId], map: "payment_submissions_order_id_idx")
  @@index([status], map: "payment_submissions_status_idx")
  @@index([status, createdAt(sort: Desc)], map: "payment_submissions_status_created_idx")
  @@map("payment_submissions")
}

model PaymentAuditEvent {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentSubmissionId String            @map("payment_submission_id") @db.Uuid
  action              PaymentAuditAction
  performedById       String?           @map("performed_by_id") @db.Uuid
  note                String?           @db.VarChar(1000)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  paymentSubmission   PaymentSubmission @relation(fields: [paymentSubmissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  performedBy         User?             @relation("PaymentAuditActor", fields: [performedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([paymentSubmissionId, createdAt], map: "payment_audit_events_submission_created_idx")
  @@index([performedById], map: "payment_audit_events_performed_by_idx")
  @@map("payment_audit_events")
}

model OrderStatusHistory {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String      @map("order_id") @db.Uuid
  previousStatus OrderStatus? @map("previous_status")
  newStatus      OrderStatus  @map("new_status")
  changedBy      String?     @map("changed_by") @db.Uuid
  note           String?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changedByUser  User?       @relation(fields: [changedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orderId, createdAt], map: "order_status_history_order_created_idx")
  @@index([changedBy], map: "order_status_history_changed_by_idx")
  @@map("order_status_history")
}

model PaymentSettings {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singletonKey  String        @default("default") @map("singleton_key") @db.VarChar(40)
  paymentMethod PaymentMethod  @default(BANK_TRANSFER) @map("payment_method")
  bankName      String        @map("bank_name") @db.VarChar(180)
  accountName   String        @map("account_name") @db.VarChar(180)
  accountNumber String        @map("account_number") @db.VarChar(80)
  instructions  String        @db.Text
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive], map: "payment_settings_active_idx")
  @@unique([singletonKey, paymentMethod], map: "payment_settings_singleton_method_key")
  @@map("payment_settings")
}

model StoreSettings {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singletonKey    String   @unique @default("default") @map("singleton_key") @db.VarChar(40)
  businessName    String   @map("business_name") @db.VarChar(180)
  businessEmail   String   @map("business_email") @db.VarChar(255)
  businessPhone   String   @map("business_phone") @db.VarChar(40)
  whatsappNumber  String   @map("whatsapp_number") @db.VarChar(40)
  callToOrderPhone String  @map("call_to_order_phone") @db.VarChar(40)
  announcementText String  @map("announcement_text") @db.VarChar(2000)
  address         String   @db.VarChar(500)
  description     String   @db.VarChar(500)
  openingHours    String   @default("") @map("opening_hours") @db.VarChar(500)
  pickupInformation String @default("") @map("pickup_information") @db.VarChar(1000)
  deliveryInformation String @default("") @map("delivery_information") @db.VarChar(1000)
  mapEmbedUrl     String   @default("") @map("map_embed_url") @db.VarChar(2000)
  logoUrl         String?  @map("logo_url") @db.VarChar(1000)
  logoPublicId    String?  @map("logo_public_id") @db.VarChar(255)
  faviconUrl      String?  @map("favicon_url") @db.VarChar(1000)
  faviconPublicId String?  @map("favicon_public_id") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("store_settings")
}

model PromotionalBanner {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String   @db.VarChar(180)
  imageUrl        String   @map("image_url") @db.VarChar(1000)
  imagePublicId   String   @map("image_public_id") @db.VarChar(255)
  promotionalText String?  @map("promotional_text") @db.VarChar(500)
  buttonText      String?  @map("button_text") @db.VarChar(120)
  destination     String?  @db.VarChar(500)
  isActive        Boolean  @default(true) @map("is_active")
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, displayOrder], map: "promotional_banners_active_order_idx")
  @@index([createdAt], map: "promotional_banners_created_at_idx")
  @@map("promotional_banners")
}

model User {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String         @db.VarChar(180)
  email        String         @unique @db.VarChar(255)
  passwordHash String?        @map("password_hash") @db.VarChar(255)
  role         UserRole       @default(ADMIN)
  authProvider AuthProvider   @default(PASSWORD) @map("auth_provider")
  googleSubject String?       @unique @map("google_subject") @db.VarChar(255)
  emailVerified Boolean       @default(true) @map("email_verified")
  shoppingMode ShoppingMode   @default(RETAIL) @map("shopping_mode")
  phone        String?        @db.VarChar(40)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt  DateTime?      @map("last_login_at") @db.Timestamptz(6)
  sessions     AdminSession[]
  customerSessions CustomerSession[]
  emailVerification CustomerEmailVerification?
  passwordResetTokens PasswordResetToken[]
  orders       Order[]
  archivedOrders Order[] @relation("OrderArchiveActor")
  orderStatusChanges OrderStatusHistory[]
  carts        CustomerCart[]
  paymentAuditEvents PaymentAuditEvent[] @relation("PaymentAuditActor")
  notificationReads AdminNotificationRead[]
  wishlistItems WishlistItem[]
  quoteRequests QuoteRequest[]
  reviews      Review[]

  @@map("users")
