model Review {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String       @map("product_id") @db.Uuid
  userId           String?      @map("user_id") @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  orderItemId      String       @unique @map("order_item_id") @db.Uuid
  rating           Int
  content          String       @db.Text
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false) @map("verified_purchase")
  isActive         Boolean      @default(true) @map("is_active")
  isFeatured       Boolean      @default(false) @map("is_featured")
  displayOrder     Int          @default(0) @map("display_order")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product          Product      @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderItem        OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([productId, status], map: "reviews_product_status_idx")
  @@index([productId, status, createdAt(sort: Desc)], map: "reviews_public_product_created_idx")
  @@index([productId, isFeatured, displayOrder], map: "reviews_product_featured_order_idx")
  @@index([isFeatured, isActive, displayOrder], map: "reviews_featured_active_order_idx")
  @@index([userId, createdAt(sort: Desc)], map: "reviews_user_created_idx")
  @@index([orderId], map: "reviews_order_id_idx")
  @@index([status], map: "reviews_status_idx")
  @@map("reviews")
}

