{
  "framework": "vite",
  "installCommand": "npm ci && npm --prefix client ci --legacy-peer-deps",
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://RENDER_API_URL_PLACEHOLDER/api/v1/$1"
    },
    {
      "source": "/api/v1",
      "destination": "https://RENDER_API_URL_PLACEHOLDER/api/v1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
